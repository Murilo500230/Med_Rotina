PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=medrotina
DB_USER=medrotina_user
DB_PASSWORD=medrotina_pass

JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=1d

# T14: Configurações da Rotina de Alertas ao Cuidador
ALERTAS_AUTOMATICOS=true
ALERTAS_INTERVALO_MINUTOS=5
ALERTA_TOLERANCIA_MINUTOS=30

# Opcional: Configurações de envio real de e-mail (SMTP)
# Se não preenchidos, os alertas são disparados e registrados no banco em modo simulado
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=alerta@medrotina.com.br
